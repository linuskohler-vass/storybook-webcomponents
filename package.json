{
  "name": "liko-webcomponents",
  "version": "1.0.0",
  "description": "Framework-agnostic web components built with Vite",
  "type": "module",
  "main": "./dist/index.js",
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/*.js",
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": true,
  "scripts": {
    "start": "npm run storybook",
    "test": "npm run test:unit && npm run test:a11y",
    "test:unit": "vitest run --project unit",
    "test:a11y": "vitest run --project storybook",
    "test:browsers": "TEST_BROWSERS=chromium,firefox,webkit vitest run --project storybook",
    "test:core-web-vitals": "npm run build-storybook && lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build",
    "chromatic": "chromatic",
    "package": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\" && npm pack --pack-destination artifacts",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "format": "prettier --write './src/**/*.{css,js,jsx}' './stories/**/*.{js,jsx}'",
    "format:check": "prettier --check './src/**/*.{css,js,jsx}' './stories/**/*.{js,jsx}'",
    "lint:js": "eslint './src/**/*.{js,jsx}' './stories/**/*.{js,jsx}'",
    "lint": "npm run format:check && npm run lint:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuskohler-vass/storybook-webcomponents.git"
  },
  "keywords": [],
  "author": "Linus Kohler",
  "bugs": {
    "url": "https://github.com/linuskohler-vass/storybook-webcomponents/issues"
  },
  "homepage": "https://github.com/linuskohler-vass/storybook-webcomponents#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.2",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/web-components-vite": "^10.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-storybook": "^10.2.8",
    "globals": "^17.3.0",
    "lit": "^3.3.2",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.1.18",
    "vite": "^7.1.12",
    "vitest": "^4.0.18"
  }
}
