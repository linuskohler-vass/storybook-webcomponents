{
  "name": "storybook-webcomponents",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "npm run storybook",
    "test": "vitest run --project storybook",
    "test:browsers": "TEST_BROWSERS=chromium,firefox,webkit vitest run --project storybook",
    "test:lighthouse": "npm run build-storybook && npm run lighthouse",
    "chromatic": "chromatic",
    "lighthouse": "node scripts/lighthouse.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build",
    "format": "prettier --write './src/**/*.{css,js,jsx}' './stories/**/*.{js,jsx}'",
    "format:check": "prettier --check './src/**/*.{css,js,jsx}' './stories/**/*.{js,jsx}'",
    "lint:js": "eslint './src/**/*.{js,jsx}' './stories/**/*.{js,jsx}'",
    "lint": "npm run format:check && npm run lint:js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuskohler-vass/storybook-webcomponents.git"
  },
  "keywords": [],
  "author": "Linus Kohler",
  "bugs": {
    "url": "https://github.com/linuskohler-vass/storybook-webcomponents/issues"
  },
  "homepage": "https://github.com/linuskohler-vass/storybook-webcomponents#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/web-components-vite": "^10.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/browser-playwright": "^5.0.3",
    "chromatic": "18.10.1",
    "chrome-launcher": "1.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.2.8",
    "globals": "^17.3.0",
    "lighthouse": "13.5.0",
    "lit": "^3.3.2",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.1.18",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
